---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ModernArticle from '../components/ModernArticle.astro';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map(page => ({
    params: { slug: page.data.langue === 'fr' ? page.data.url : `en/${page.data.url}` },
    props: { page },
  }));
}
const { page } = Astro.props;
const d = page.data;
---
<Base langue={d.langue} titre={d.titre} description={d.description} slug={d.url}>
  <ModernArticle page={page} />
</Base>
