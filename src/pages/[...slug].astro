---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { media } from '../components/Media';
import Base from '../layouts/Base.astro';
import type { Langue } from '../i18n/ui';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.data.langue === 'fr' ? page.data.url : `en/${page.data.url}` },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const banniere = media(d.banniere);
const cartes = (d.cartes ?? []).map((k) => ({ ...k, src: media(k.image) }));
const galerie = (d.galerie ?? [])
  .map((g) => ({ ...g, src: media(g.image) }))
  .filter((g) => g.src);
---

<Base langue={d.langue as Langue} titre={d.titre} description={d.description} slug={d.url}>
  <article>
    <header class:list={['banniere', { 'banniere--avec-portrait': banniere && d.banniere_cadrage === 'portrait' }]}>
      <div class="enveloppe banniere__grille">
        <div class="banniere__texte">
          {d.surtitre && <p class="surtitre reveler">{d.surtitre}</p>}
          <h1 class="reveler">{d.titre}</h1>
          {d.chapeau && <p class="chapeau reveler">{d.chapeau}</p>}
        </div>
        {banniere && d.banniere_cadrage === 'portrait' && (
          <Image src={banniere} alt={d.titre} class="banniere__portrait reveler" width={620} loading="eager" />
        )}
      </div>
    </header>

    {banniere && d.banniere_cadrage === 'large' && (
      <div class="enveloppe">
        <Image src={banniere} alt="" class="banniere__large reveler" width={1400} loading="eager" />
      </div>
    )}

    {banniere && d.banniere_cadrage === 'entier' && (
      <div class="enveloppe">
        <figure class="banniere__entier reveler">
          <Image src={banniere} alt={d.titre} width={1100} loading="eager" />
        </figure>
      </div>
    )}

    {cartes.length > 0 && (
      <div class="enveloppe">
        <ul class="cartes">
          {cartes.map((k, i) => (
            <li class="carte reveler" style={`transition-delay:${i * 0.07}s`}>
              {k.src && (
                <Image
                  src={k.src}
                  alt=""
                  class:list={["carte__image", `carte__image--${k.cadrage}`]}
                  width={640}
                  loading="lazy"
                />
              )}
              <div class="carte__corps">
                <h2 class="carte__titre">{k.titre}</h2>
                {k.texte && <p class="carte__texte">{k.texte}</p>}
                {k.lien && (
                  <a class="carte__lien" href={k.lien}>
                    {k.lienLibelle ?? k.titre}<span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="enveloppe">
      <div class:list={['prose', { 'prose--numerotee': d.sections_numerotees }, 'reveler']}>
        <Content />
      </div>
    </div>

    {(d.etapes ?? []).length > 0 && (
      <div class="enveloppe">
        <ol class="etapes">
          {d.etapes!.map((e, i) => (
            <li class="etape reveler" style={`transition-delay:${i * 0.07}s`}>
              <span class="etape__rang" aria-hidden="true">{i + 1}</span>
              <div>
                <h2 class="etape__titre">{e.titre}</h2>
                <p class="etape__texte">{e.texte}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    {galerie.length > 0 && (
      <div class="enveloppe">
        <ul class="galerie">
          {galerie.map((g, i) => (
            <li class:list={['galerie__element', `galerie__element--${g.cadrage}`, 'reveler']} style={`transition-delay:${i * 0.07}s`}>
              <Image src={g.src!} alt={g.legende ?? ''} width={720} loading="lazy" />
              {g.legende && <p class="galerie__legende">{g.legende}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Base>

<style>
  /* Photo paysage : bandeau pleine largeur */
  .banniere__large {
    width: 100%;
    height: clamp(14rem, 34vw, 26rem);
    object-fit: cover;
    border-radius: 1rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--ombre-douce);
  }

  /* Infographie : jamais recadree, posee sur un fond doux */
  .banniere__entier {
    margin: clamp(2rem, 5vw, 3.5rem) auto 0;
    max-width: 46rem;
    background: var(--papier-ombre);
    border-radius: 1rem;
    padding: clamp(1rem, 3vw, 2.5rem);
  }
  .banniere__entier img {
    width: 100%;
    height: auto;
    border-radius: .5rem;
  }

  /* Image verticale : a cote du texte d'introduction */
  .banniere__grille { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .banniere--avec-portrait .banniere__grille { grid-template-columns: 1fr; }
  @media (min-width: 54rem) {
    .banniere--avec-portrait .banniere__grille {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .banniere__portrait {
    width: 100%;
    height: auto;
    max-height: 30rem;
    object-fit: cover;
    object-position: center top;
    border-radius: 1rem;
    box-shadow: var(--ombre-forte);
  }

  /* Sections numerotees : le rang s'affiche en gros chiffre ocre */
  .prose--numerotee { counter-reset: argument; }
  .prose--numerotee :global(h2) {
    counter-increment: argument;
    padding-left: 3.6rem;
    min-height: 2.6rem;
  }
  .prose--numerotee :global(h2::after) {
    content: counter(argument);
    position: absolute;
    left: 0;
    top: .9rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--orange);
  }
  @media (max-width: 34rem) {
    .prose--numerotee :global(h2) { padding-left: 2.8rem; }
    .prose--numerotee :global(h2::after) { font-size: 1.9rem; top: 1.1rem; }
  }

  /* Etapes */
  .etapes {
    list-style: none;
    counter-reset: etape;
    margin: clamp(2rem, 5vw, 3.5rem) 0 clamp(2rem, 5vw, 3.5rem);
    padding: 0;
    display: grid;
    gap: 1.5rem;
    max-width: 46rem;
  }
  .etape {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--trait);
  }
  .etape:last-child { border-bottom: 0; padding-bottom: 0; }
  .etape__rang {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--teal);
    color: #fff;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.1rem;
  }
  .etape__titre { font-size: 1.18rem; margin: .25rem 0 .4rem; }
  .etape__texte { color: var(--encre-douce); margin: 0; font-size: .97rem; }

  .cartes {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .carte {
    display: flex;
    flex-direction: column;
    background: var(--papier);
    border: 1px solid var(--trait);
    border-radius: 1rem;
    overflow: hidden;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
  }
  .carte:hover {
    transform: translateY(-4px);
    box-shadow: var(--ombre-forte);
    border-color: color-mix(in srgb, var(--orange) 45%, var(--trait));
  }
  .carte__image { width: 100%; aspect-ratio: 16 / 10; }
  .carte__image--photo { object-fit: cover; }
  .carte__image--logo {
    object-fit: contain;
    background: var(--papier-ombre);
    padding: 1.5rem 2rem;
    aspect-ratio: 5 / 2;
  }
  .carte__corps {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    flex: 1;
  }
  .carte__titre { font-size: 1.22rem; margin: 0; }
  .carte__texte { color: var(--encre-douce); font-size: .95rem; margin: 0; flex: 1; }
  .carte__lien {
    margin-top: .5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: .9rem;
    color: var(--teal-fonce);
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }
  .carte__lien span { transition: transform .2s ease; }
  .carte:hover .carte__lien span { transform: translateX(4px); }

  .galerie {
    list-style: none;
    margin: 0 0 clamp(3rem, 7vw, 5rem);
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .galerie__element img {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: .75rem;
  }
  /* Photographie : l'image occupe tout le cadre */
  .galerie__element--photo img {
    object-fit: cover;
    box-shadow: var(--ombre-douce);
  }
  /* Logo : respiration autour, sur fond neutre */
  .galerie__element--logo img {
    object-fit: contain;
    background: var(--papier-ombre);
    padding: 1.5rem;
    aspect-ratio: 3 / 2;
  }
  .galerie__legende {
    margin: .75rem 0 0;
    font-size: .9rem;
    color: var(--encre-douce);
    text-align: center;
  }

  .banniere {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(60rem 28rem at 15% -10%, var(--orange-clair), transparent 60%),
      radial-gradient(48rem 26rem at 95% 0%, var(--teal-clair), transparent 62%);
    border-bottom: 1px solid var(--trait);
  }
  .banniere h1 { max-width: 20ch; margin-bottom: 0; }
  .chapeau {
    font-size: clamp(1.08rem, 1rem + .5vw, 1.35rem);
    line-height: 1.55;
    color: var(--encre-douce);
    max-width: 46ch;
    margin-top: 1.4rem;
  }

  .prose {
    max-width: 44rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    font-size: 1.06rem;
  }

  /* Titres de section : filet orange en amorce */
  .prose :global(h2) {
    margin-top: 2.75em;
    padding-top: 1.1rem;
    border-top: 1px solid var(--trait);
    position: relative;
  }
  .prose :global(h2::before) {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 3.5rem;
    height: 2px;
    background: var(--orange);
  }
  .prose :global(h2:first-child) { margin-top: 0; border-top: 0; padding-top: 0; }
  .prose :global(h2:first-child::before) { display: none; }

  .prose :global(h3) {
    margin-top: 2.1em;
    color: var(--teal);
    font-size: 1.22rem;
  }

  /* Citation d'ouverture : grande, chaleureuse, sans guillemets decoratifs */
  .prose :global(blockquote) {
    margin: 0 0 2.5rem;
    padding: 0 0 0 1.5rem;
    border-left: 3px solid var(--orange);
    font-family: var(--display);
    font-size: clamp(1.2rem, 1.05rem + .6vw, 1.5rem);
    line-height: 1.4;
    color: var(--teal-fonce);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }

  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; margin-bottom: 1.4em; }
  .prose :global(li) { margin-bottom: .5em; }
  .prose :global(li::marker) { color: var(--orange); }
  .prose :global(strong) { color: var(--teal-fonce); }
  .prose :global(a) { color: var(--teal); text-decoration: underline; }
  .prose :global(a:hover) { color: var(--orange); }
</style>
