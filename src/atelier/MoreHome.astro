---
import { Image } from 'astro:assets';
import { accueil } from '../i18n/accueil';
import { t, type Langue } from '../i18n/ui';
import { media } from '../components/Media';
import { path, type Direction } from './paths';
const { langue, direction } = Astro.props as { langue: Langue; direction: Direction };
const c = accueil[langue];
const tr = t(langue);
---
<!-- Preserve every original home section, including the two additional messages. -->
<section class="other-messages" aria-label={c.diapoAller}>
  {c.diapos.slice(1).map((d) => { const image = media(d.image); return (
    <details class="message">
      <summary>{d.titre.replace(/\*/g, '')}</summary>
      <div class="message-body">{image && <Image src={image} alt="" width={1000} loading="lazy" />}<div><p>{d.texte}</p>{d.auteur && <p>{d.auteur}</p>}<a class="text-link" href={path(direction, langue, d.lien)}>{d.lienLibelle}</a></div></div>
    </details>
  ); })}
</section>
<section class="destination section-pad">
  <div class="section-intro"><h2>{c.raisonsTitre}</h2><a class="text-link" href={path(direction, langue, c.raisonsLien)}>{c.raisonsSurtitre}</a></div>
  <div class="destination-list">{c.raisons.map((r) => <article><p class="fact">{r.chiffre}</p><h3>{r.titre}</h3><p>{r.texte}</p></article>)}</div>
</section>
<section class="testimonials section-pad">
  <div class="section-intro"><h2>{c.temoignagesTitre}</h2><a class="text-link" href={path(direction, langue, c.temoignagesLien)}>{c.temoignagesSurtitre}</a></div>
  <div class="quotes">{c.temoignages.map((m) => <figure><blockquote>{m.texte}</blockquote>{m.auteur && <figcaption>{m.auteur}</figcaption>}</figure>)}</div>
</section>
