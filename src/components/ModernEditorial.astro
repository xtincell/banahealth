---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { media } from './Media';
import { editorialSections, serviceChapters } from '../lib/editorial';
import { t, chemin } from '../i18n/ui';
import labels from '../textes/presentation.yaml';
import photographs from '../textes/photographies.yaml';
const { page, family } = Astro.props as { page: CollectionEntry<'pages'>; family: 'services' | 'care' | 'destination' | 'network' };
const d = page.data, tr = t(d.langue), ui = labels[d.langue];
const { intro, sections } = editorialSections(await Astro.slots.render('default'));
const services = family === 'services' ? serviceChapters(sections) : null;
const cards = d.cartes ?? [];
const networkIntro = family === 'network' ? sections.slice(0, -cards.length) : [];
const institutions = family === 'network' ? sections.slice(-cards.length) : [];
if (family === 'network' && institutions.length !== cards.length) throw new Error('Network: unmatched institution and source section.');
const destination = d.galerie?.at(-1);
---
<article class={`bh-editorial bh-editorial-${family}`}>
  <header class="bh-editorial-heading">
    <a href={chemin(d.langue)}>{ui.retour}</a>
    {!['services', 'destination'].includes(family) && <h1>{d.titre}</h1>}
    {d.surtitre && <p class="bh-editorial-overline">{d.surtitre}</p>}
    {d.chapeau && <p class="bh-editorial-lead">{d.chapeau}</p>}
  </header>

  {services && <>
    {(intro.trim() || services.prefix.length > 0) && <div class="bh-editorial-prefix" data-editorial><Fragment set:html={intro + services.prefix.map(s => s.heading + s.body).join('')} /></div>}
    <div class="bh-service-chapters">
      {services.chapters.map((chapter, i) => <section class="bh-service-chapter">
        <figure class="bh-chapter-photo">
          <div class="bh-chapter-frame"><Image src={media(photographs.services[i].image)!} alt="" widths={[640, 1000, 1400]} sizes="(max-width: 760px) 100vw, 55vw" loading={i === 0 ? 'eager' : 'lazy'} />{i === 0 && <h1>{d.titre}</h1>}</div>
          {photographs.services[i].origine === 'generated' && <figcaption class="bh-photo-note">{photographs.mentions[d.langue]}</figcaption>}
        </figure>
        <div class="bh-chapter-content">
          <div class="bh-chapter-title" data-editorial><Fragment set:html={chapter.title.heading + chapter.title.body} /></div>
          {chapter.entries.map((entry, j) => <details class="bh-service-detail" open={i === 0 && j === 0}>
            <summary><div data-editorial><Fragment set:html={entry.heading} /></div><span class="bh-plus" aria-hidden="true">+</span></summary>
            <div class="bh-detail-copy" data-editorial><Fragment set:html={entry.body} /></div>
          </details>)}
        </div>
      </section>)}
    </div>
    <details class="bh-original-document"><summary>{ui.documentOriginal}<span class="bh-plus" aria-hidden="true">+</span></summary><Image src={media(d.banniere)!} alt={d.titre} widths={[640, 1000, 1400]} sizes="(max-width: 760px) 100vw, 70vw" loading="lazy" /></details>
  </>}

  {family === 'care' && <>
    {intro.trim() && <div class="bh-care-intro" data-editorial><Fragment set:html={intro} /></div>}
    <div class="bh-care-index">
      {cards.map((card, i) => <section class="bh-care-item">
        <a class="bh-care-photo" href={card.lien}><Image src={media(card.image)!} alt="" widths={[500, 800, 1100]} sizes="(max-width: 760px) 100vw, 50vw" loading={i < 2 ? 'eager' : 'lazy'} /><h2>{card.titre}</h2></a>
        <div class="bh-care-caption"><p>{card.texte}</p><a href={card.lien}>{card.lienLibelle}</a></div>
        {d.langue === 'fr' && sections[i] && <details class="bh-care-detail"><summary>{ui.details}<span class="bh-plus" aria-hidden="true">+</span></summary><div class="bh-detail-copy" data-editorial><Fragment set:html={sections[i].heading + sections[i].body} /></div></details>}
      </section>)}
    </div>
    {(d.langue === 'en' || sections.length > cards.length) && <div class="bh-care-guidance">{(d.langue === 'en' ? sections : sections.slice(cards.length)).map(section => <section data-editorial><Fragment set:html={section.heading + section.body} /></section>)}</div>}
  </>}

  {family === 'destination' && <>
    <figure class="bh-destination-opening"><div class="bh-destination-frame"><Image src={media(destination!.image)!} alt="" widths={[640, 1000, 1600]} sizes="100vw" loading="eager" /><h1>{d.titre}</h1></div><figcaption>{destination!.legende}</figcaption></figure>
    <div class="bh-destination-intro" data-editorial><Fragment set:html={intro + sections[0].heading + sections[0].body} /></div>
    <div class="bh-reasons">{sections.slice(1).map((reason, i) => <section class:list={['bh-reason', { 'bh-reason-last': i === 4 }]}>
      {i < 4 && <figure><Image src={media(d.galerie![i].image)!} alt="" widths={[500, 800, 1100]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" /><figcaption>{d.galerie![i].legende}</figcaption></figure>}
      <div class="bh-reason-copy" data-editorial><Fragment set:html={reason.heading + reason.body} /></div>
    </section>)}</div>
  </>}

  {family === 'network' && <div class="bh-network-directory">
    <div class="bh-network-intro" data-editorial><Fragment set:html={intro + networkIntro.map(s => s.heading + s.body).join('')} /></div>
    <div class="bh-institutions">{cards.map((card, i) => <section class="bh-institution">
      <details><summary><span class="bh-institution-logo"><Image src={media(card.image)!} alt="" width={400} loading={i < 3 ? 'eager' : 'lazy'} /></span><h3>{card.titre}</h3><span class="bh-plus" aria-hidden="true">+</span></summary><div class="bh-institution-copy" data-editorial><Fragment set:html={institutions[i].heading + institutions[i].body} /></div></details>
      <a class="bh-institution-link" href={card.lien}>{card.lienLibelle}</a>
    </section>)}</div>
  </div>}

  <div class="bh-article-contact"><a class="bh-action" href={chemin(d.langue, 'contact')}>{tr('cta.contact')}<span aria-hidden="true">↗</span></a></div>
</article>
