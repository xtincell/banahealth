---
import { Image } from 'astro:assets';
import { t, chemin, type Langue } from '../i18n/ui';
import { accueil } from '../i18n/accueil';
import { media } from './Media';
import Diaporama from './Diaporama.astro';

interface Props { langue: Langue; }
const { langue } = Astro.props;
const tr = t(langue);
const c = accueil[langue];
const portrait = media('marie-ngameni');
---

<Diaporama langue={langue} />

<!-- ================= Trois piliers ================= -->
<section class="section">
  <div class="enveloppe">
    <p class="surtitre reveler">{c.piliersSurtitre}</p>
    <h2 class="reveler titre-section">{c.piliersTitre}</h2>

    <ul class="piliers">
      {c.piliers.map((p, i) => {
        const img = media(p.image);
        return (
          <li class="pilier reveler" style={`transition-delay:${i * 0.09}s`}>
            {img && <Image src={img} alt="" class="pilier__icone" width={96} height={96} loading="lazy" />}
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
            <a class="pilier__lien" href={chemin(langue, p.lien)}>{tr('cta.suite')}<span aria-hidden="true">→</span></a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<!-- ================= Pourquoi l'Afrique du Sud ================= -->
<section class="section section--creme">
  <div class="enveloppe">
    <p class="surtitre reveler">{c.raisonsSurtitre}</p>
    <h2 class="reveler titre-section">{c.raisonsTitre}</h2>

    <ul class="raisons">
      {c.raisons.map((r, i) => (
        <li class="raison reveler" style={`transition-delay:${i * 0.09}s`}>
          <span class="raison__chiffre">{r.chiffre}</span>
          <h3>{r.titre}</h3>
          <p>{r.texte}</p>
        </li>
      ))}
    </ul>

    <p class="reveler">
      <a class="bouton bouton--contour" href={chemin(langue, c.raisonsLien)}>{tr('cta.suite')}</a>
    </p>
  </div>
</section>

<!-- ================= Fondatrice ================= -->
<section class="section">
  <div class="enveloppe fondatrice">
    {portrait && (
      <Image src={portrait} alt="Marie Ngameni" class="fondatrice__portrait reveler" width={620} loading="lazy" />
    )}
    <div class="fondatrice__texte reveler">
      <p class="surtitre">{c.fondatriceSurtitre}</p>
      <h2>{c.fondatriceTitre}</h2>
      <p>{c.fondatriceTexte}</p>
      <a class="bouton bouton--contour" href={chemin(langue, c.fondatriceLien)}>{tr('cta.suite')}</a>
    </div>
  </div>
</section>

<!-- ================= Temoignages ================= -->
<section class="section section--vert">
  <div class="enveloppe">
    <p class="surtitre reveler">{c.temoignagesSurtitre}</p>
    <h2 class="reveler titre-section">{c.temoignagesTitre}</h2>

    <ul class="temoignages">
      {c.temoignages.map((m, i) => (
        <li class="temoignage reveler" style={`transition-delay:${i * 0.08}s`}>
          <blockquote>
            <p>{m.texte}</p>
          </blockquote>
          {m.auteur && <p class="temoignage__auteur">{m.auteur}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ================= Appel ================= -->
<section class="section appel">
  <div class="enveloppe etroit appel__contenu reveler">
    <h2>{c.appelTitre}</h2>
    <p>{c.appelTexte}</p>
    <a class="bouton bouton--plein" href="mailto:hello@banahealth.care">hello@banahealth.care</a>
    <p class="appel__tel">
      <a href="tel:+27826844154">+27 (0) 82 684 4154</a> · <a href="tel:+27827756975">+27 (0) 82 775 6975</a>
    </p>
  </div>
</section>

<style>
  .titre-section { max-width: 18ch; margin-bottom: 2.75rem; }

  /* ---------- Piliers ---------- */
  .piliers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .pilier {
    background: var(--papier);
    border: 1px solid var(--trait);
    border-radius: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: .35rem;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
  }
  .pilier:hover {
    transform: translateY(-4px);
    box-shadow: var(--ombre-forte);
    border-color: color-mix(in srgb, var(--orange) 45%, var(--trait));
  }
  .pilier__icone { width: 3.4rem; height: 3.4rem; object-fit: contain; margin-bottom: .9rem; }
  .pilier h3 { margin-bottom: .35em; }
  .pilier p { color: var(--encre-douce); flex: 1; font-size: .97rem; }
  .pilier__lien {
    text-decoration: none;
    font-weight: 800;
    font-size: .9rem;
    color: var(--teal-fonce);
    display: inline-flex;
    gap: .4rem;
    align-items: center;
  }
  .pilier__lien span { transition: transform .2s ease; }
  .pilier__lien:hover span { transform: translateX(4px); }

  /* ---------- Raisons ---------- */
  .raisons {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .raison { border-top: 2px solid var(--orange); padding-top: 1.25rem; }
  .raison__chiffre {
    display: block;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2.4rem, 1.9rem + 2.2vw, 3.6rem);
    line-height: 1;
    color: var(--teal-fonce);
    margin-bottom: .6rem;
  }
  .raison h3 { font-size: 1.08rem; margin-bottom: .45em; }
  .raison p { color: var(--encre-douce); font-size: .95rem; margin: 0; }

  /* ---------- Fondatrice ---------- */
  .fondatrice {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .fondatrice:has(.fondatrice__portrait) { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  }
  .fondatrice__portrait {
    width: 100%;
    height: auto;
    max-height: 32rem;
    object-fit: cover;
    object-position: center top;
    border-radius: 1rem;
    box-shadow: var(--ombre-forte);
  }
  .fondatrice__texte h2 { max-width: 16ch; }
  .fondatrice__texte p { color: var(--encre-douce); max-width: 46ch; margin-bottom: 1.75rem; }

  /* ---------- Temoignages ---------- */
  .temoignages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .temoignage {
    border-left: 2px solid var(--orange);
    padding-left: 1.4rem;
  }
  .temoignage blockquote { margin: 0; }
  .temoignage blockquote p {
    color: rgba(255, 255, 255, .9);
    font-size: .99rem;
    line-height: 1.62;
    margin: 0 0 .9rem;
  }
  .temoignage__auteur {
    margin: 0;
    font-weight: 800;
    font-size: .82rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--orange);
  }

  /* ---------- Appel ---------- */
  .appel__contenu { text-align: center; }
  .appel__contenu h2 { max-width: none; }
  .appel__contenu > p { color: var(--encre-douce); margin-bottom: 2rem; }
  .appel__tel { margin-top: 1.5rem; font-size: .95rem; color: var(--encre-douce); }
  .appel__tel a { color: var(--teal-fonce); text-decoration: none; }
  .appel__tel a:hover { color: var(--orange); text-decoration: underline; }
</style>
