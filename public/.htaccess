# =========================================================
# banahealth.care — site statique
#
# Aucun PHP n'est servi ici : le site est entierement
# pre-genere. Les regles ci-dessous verrouillent ce qui
# pourrait l'etre malgre tout, et refusent explicitement
# l'execution de scripts.
# =========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Toujours en HTTPS ---
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # =======================================================
  # Redirections des anciennes adresses WordPress
  #
  # Le site precedent vivait sous /wordpress/ et melait les
  # deux langues sur les memes slugs, distinguees par ?lang=.
  # Ces regles preservent le referencement acquis et evitent
  # que les liens indexes par Google ne tombent dans le vide.
  # =======================================================

  # L'ancien prefixe disparait : on le retire avant tout le reste.
  RewriteRule ^wordpress/?$ https://banahealth.care/ [R=301,L]
  RewriteRule ^wordpress/(.*)$ https://banahealth.care/$1 [R=301,L]

  # --- Slugs partages entre les deux langues : le francais d'abord ---
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^accommodation/?$ https://banahealth.care/hebergement/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^contact-us/?$ https://banahealth.care/contact/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^testimonials/?$ https://banahealth.care/temoignages/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^useful-links/?$ https://banahealth.care/liens-utiles/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^general-check-up/?$ https://banahealth.care/bilan-de-sante/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^our-network/?$ https://banahealth.care/nos-reseaux/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
  RewriteRule ^services/?$ https://banahealth.care/nos-services/ [R=301,L,QSD]

  # --- Anciennes adresses francaises dont le slug a change ---
  RewriteRule ^page-daccueil/?$ https://banahealth.care/ [R=301,L,QSD]
  RewriteRule ^pourquoi-lafrique-du-sud/?$ https://banahealth.care/pourquoi-afrique-du-sud/ [R=301,L,QSD]
  RewriteRule ^vitro-fertilization-ivf/?$ https://banahealth.care/fecondation-in-vitro/ [R=301,L,QSD]

  # --- Anciennes adresses anglaises ---
  RewriteRule ^sample-page/?$ https://banahealth.care/en/ [R=301,L,QSD]
  RewriteRule ^blog/?$ https://banahealth.care/en/ [R=301,L,QSD]
  RewriteRule ^meet-the-founder/?$ https://banahealth.care/en/our-founder/ [R=301,L,QSD]
  RewriteRule ^vision-and-mission/?$ https://banahealth.care/en/vision-and-mission/ [R=301,L,QSD]
  RewriteRule ^services/?$ https://banahealth.care/en/our-services/ [R=301,L,QSD]
  RewriteRule ^accommodation/?$ https://banahealth.care/en/accommodation/ [R=301,L,QSD]
  RewriteRule ^why-south-africa/?$ https://banahealth.care/en/why-south-africa/ [R=301,L,QSD]
  RewriteRule ^our-network(-2)?/?$ https://banahealth.care/en/our-network/ [R=301,L,QSD]
  RewriteRule ^testimonials/?$ https://banahealth.care/en/testimonials/ [R=301,L,QSD]
  RewriteRule ^useful-links/?$ https://banahealth.care/en/useful-links/ [R=301,L,QSD]
  RewriteRule ^contact-us/?$ https://banahealth.care/en/contact/ [R=301,L,QSD]
  RewriteRule ^in-vitro-fertilization-ivf/?$ https://banahealth.care/en/in-vitro-fertilisation/ [R=301,L,QSD]
  RewriteRule ^oncology/?$ https://banahealth.care/en/oncology/ [R=301,L,QSD]
  RewriteRule ^surgeries/?$ https://banahealth.care/en/surgeries/ [R=301,L,QSD]
  RewriteRule ^general-check-up/?$ https://banahealth.care/en/general-check-up/ [R=301,L,QSD]
  RewriteRule ^privacy-policy/?$ https://banahealth.care/en/privacy-policy/ [R=301,L,QSD]
  RewriteRule ^(terms-and-conditions|conditions)/?$ https://banahealth.care/en/terms-and-conditions/ [R=301,L,QSD]
  # Le site statique ne depose aucun cookie : la page d'origine n'a
  # plus d'objet, sa remplacante est la politique de confidentialite.
  RewriteRule ^cookie-policy/?$ https://banahealth.care/en/privacy-policy/ [R=301,L,QSD]

  # --- Restes de WordPress : plus rien a servir ---
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-login\.php|xmlrpc\.php) https://banahealth.care/ [R=301,L]

  # --- Le parametre de langue de l'ancien systeme n'a plus cours ---
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
  RewriteRule ^(.*)$ https://banahealth.care/$1 [R=301,L,QSD]
</IfModule>

# --- Aucun script ne doit s'executer sur ce site ---
<FilesMatch "\.(php|php\d|phtml|phps|pl|py|cgi|sh|lua)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8

# --- Fichiers sensibles ou techniques ---
<FilesMatch "^\.|\.(env|ini|log|sql|bak|old|swp|json|lock|yml|yaml)$">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>
# Le manifeste du site reste lisible
<Files "site.webmanifest">
  Require all granted
</Files>

# --- Pas de listage de repertoire ---
Options -Indexes -ExecCGI
DirectoryIndex index.html

# --- En-tetes de securite ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Le site ne charge que ses propres ressources, plus les polices Google
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Page d'erreur ---
ErrorDocument 404 /404.html

# --- Mise en cache ---
<IfModule mod_expires.c>
  ExpiresActive On
  # Les fichiers compiles portent une empreinte dans leur nom
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "public, immutable"
  </FilesMatch>
  # Le HTML doit rester frais : il porte les liens vers les fichiers empreintes
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 10 minutes"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>
