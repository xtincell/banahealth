# Standalone preview only. Do not merge into the current production root.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'; frame-src https://www.google.com; object-src 'none'; base-uri 'none'; form-action mailto:; frame-ancestors 'self'"
</IfModule>

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|cgi|pl|py|sh|sql|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$) [NC]
  RewriteCond %{REQUEST_URI} !^/fr/
  RewriteRule ^(.*)$ /fr/$1 [R=302,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$) [NC]
  RewriteRule ^fr/(.*)$ /$1 [R=302,L,QSD]
</IfModule>
